					"pinObjectGuid": "db29deb3-2c7b-eff1-119f-33345589479a",
					"pinData": {
						"pinType": "ResourceProperty",
						"pinObjectName": "Animseq JSAsset",
						"pinPropertyName": "loopCount",
						"valueType": "Int",
						"uiAnnoatiationContent": "/**\n * @field {TextureSequence} textureSequence - {\n *    \"label\": \"2danimation_texture\"\n * }\n * \n * @field {Number} loopCount - {\n *    \"label\": \"2danimation_loopcount\",\n *    \"default\": -1,\n *    \"range\": { \"min\": -1, \"max\": 999999 },\n *    \"step\": 1,\n *    \"showMiniArrow\": false,\n *    \"precision\": 0\n * }\n * \n * @field {Number} playMode - {\n *    \"display\": \"combobox\",\n *    \"default\": 0,\n *    \"label\": \"2danimation_playmode\",\n *    \"options\": [\n *     {\"label\": \"2danimation_forward\", \"value\": 0},\n *     {\"label\": \"2danimation_pingpong\", \"value\": 1},\n *     {\"label\": \"2danimation_randomize\", \"value\": 2},\n *     {\"label\": \"2danimation_shuffle\", \"value\": 3}\n *   ]\n * }\n * \n * @field {Boolean} reverse - {\n *    \"default\": false,\n *    \"label\": \"2danimation_reverse\"\n * }\n * \n * @field {Number} fps - {\n *    \"label\": \"2danimation_fps\",\n *    \"default\": 12,\n *    \"step\": 1,\n *    \"range\": { \"min\": 1, \"max\": 9999 },\n *    \"showMiniArrow\": false,\n *    \"precision\": 0\n * }\n * \n * @field {Number} duration - {\n *    \"label\": \"2danimation_duration\",\n *    \"default\": 1.0,\n *    \"step\": 0.1,\n *    \"range\": { \"min\": 0, \"max\": 9999 },\n *    \"showMiniArrow\": false,\n *    \"precision\": 1\n * }\n */\n"
					}
				},
