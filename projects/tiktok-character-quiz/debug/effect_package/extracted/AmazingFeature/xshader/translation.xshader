%YAML 1.1
--- !XShader &1
name: !<str> ""
guid: {a: 17169776311248031692, b: 9387965361291943828}
renderQueue: 3000
passes:
  - __class: Pass
    name: !<str> ""
    guid: {a: 94364076678924819, b: 17911938055279933838}
    shaders:
      __class: Map
    angleBinaryPrograms:
      __class: Map
    semantics:
      __class: Map
      attBinormal:
        __class: VertexAttribType
        value: BINORMAL
      attBinormalOffset:
        __class: VertexAttribType
        value: BINORMAL_OFFSET
      attBoneIds:
        __class: VertexAttribType
        value: INDICES
      attColor:
        __class: VertexAttribType
        value: COLOR
      attNormal:
        __class: VertexAttribType
        value: NORMAL
      attNormalOffset:
        __class: VertexAttribType
        value: NORMAL_OFFSET
      attPosition:
        __class: VertexAttribType
        value: POSITION
      attPositionOffset:
        __class: VertexAttribType
        value: POSITION_OFFSET
      attTangent:
        __class: VertexAttribType
        value: TANGENT
      attTangentOffset:
        __class: VertexAttribType
        value: TANGENT_OFFSET
      attTexcoord0:
        __class: VertexAttribType
        value: TEXCOORD0
      attTexcoord1:
        __class: VertexAttribType
        value: TEXCOORD1
      attTexcoord2:
        __class: VertexAttribType
        value: TEXCOORD2
      attTexcoord3:
        __class: VertexAttribType
        value: TEXCOORD3
      attTexcoord3D0:
        __class: VertexAttribType
        value: TEXCOORD3D0
      attTexcoord4:
        __class: VertexAttribType
        value: TEXCOORD4
      attTexcoord5:
        __class: VertexAttribType
        value: TEXCOORD5
      attTexcoord6:
        __class: VertexAttribType
        value: TEXCOORD6
      attTexcoord7:
        __class: VertexAttribType
        value: TEXCOORD7
      attWeights:
        __class: VertexAttribType
        value: WEIGHT
    clearColor: {r: 0.5, g: 0.5, b: 0.5, a: 1}
    clearDepth: 1
    clearType:
      __class: CameraClearType
      value: DONT
    renderState:
      __class: RenderState
      name: !<str> ""
      guid: {a: 6795741715870807848, b: 1936463942887350969}
      rasterization:
        __class: RasterizationState
        name: !<str> ""
        guid: {a: 8811448521959817015, b: 13170467305086447526}
        depthClampEnable: false
        depthClampEnableName: !<str> ""
        rasterizerDiscardEnable: false
        rasterizerDiscardEnableName: !<str> ""
        polygonMode:
          __class: PolygonMode
          value: FILL
        polygonModeName: !<str> ""
        cullMode:
          __class: CullFace
          value: BACK
        cullModeName: !<str> ""
        frontFace:
          __class: FrontFace
          value: COUNTER_CLOCKWISE
        frontFaceName: !<str> ""
        depthBiasEnable: false
        depthBiasEnableName: !<str> ""
        depthBiasConstantFactor: 0
        depthBiasConstantFactorName: !<str> ""
        depthBiasClamp: 1
        depthBiasClampName: !<str> ""
        depthBiasSlopeFactor: 0
        depthBiasSlopeFactorName: !<str> ""
        lineWidth: 1
        lineWidthName: !<str> ""
      depthstencil:
        __class: DepthStencilState
        name: !<str> ""
        guid: {a: 20257525660592395, b: 11267532569246767806}
        depthTestEnable: false
        depthTestEnableName: !<str> ""
        depthCompareOp:
          __class: CompareOp
          value: LESS_OR_EQUAL
        depthCompareOpName: !<str> ""
        depthWriteEnable: false
        stencilTestEnable: false
        stencilTestEnableName: !<str> ""
      colorBlend:
        __class: ColorBlendState
        name: !<str> ""
        guid: {a: 666836587852502860, b: 6696893290812750232}
        blendConstants: {x: 0, y: 0, z: 0, w: 0}
        blendEnableName: !<str> ""
        blendFactorName: !<str> ""
        blendOpName: !<str> ""
        attachments:
          - __class: ColorBlendAttachmentState
            name: !<str> ""
            guid: {a: 7946857521446605628, b: 7320805290162649735}
            blendEnable: true
            srcColorBlendFactor:
              __class: BlendFactor
              value: SRC_ALPHA
            dstColorBlendFactor:
              __class: BlendFactor
              value: ONE_MINUS_SRC_ALPHA
            srcAlphaBlendFactor:
              __class: BlendFactor
              value: ONE
            dstAlphaBlendFactor:
              __class: BlendFactor
              value: ONE_MINUS_SRC_ALPHA
            colorWriteMask: 15
            ColorBlendOp:
              __class: BlendOp
              value: ADD
            AlphaBlendOp:
              __class: BlendOp
              value: ADD
    useFBOTexture: false
    useCameraRT: false
    useFBOFetch: false
    enableFBOFetch: false
    isFullScreenShading: false
    macrosMap:
      __class: Map
    preprocess: false
    passType:
      __class: PassType
      value: NORMAL
    keywordProgram: {localId: 1, path: xshader/translation2.xshader}
    lightMode:
      __class: LightMode
      value: NONE
    clearMoment:
      __class: PassClearMoment
      value: CLEAR_BEFORE_RENDERING
    instanceCount: 0
    useGrabTexture: false
    useGrabTextureMipmap: false
    grabTextureName: !<str> ""
