# EmDash MCP Configuration
# Copy this file to .env and fill in the actual values

# MCP Endpoint URL
EMDASH_MCP_URL=https://cms.tkpdevstudio.com/mcp

# Scoped API tokens (generate in EmDash admin)
EMDASH_CONTENT_TOKEN=em_token_xxx    # Full content CRUD
EMDASH_MEDIA_TOKEN=em_token_xxx      # Media upload only
EMDASH_ADMIN_TOKEN=em_token_xxx      # Full admin access (CTO only)
